{
  "expo": {
    "name": "KRIM Partner",
    "slug": "krim-partner",
    "owner": "krim-logistics",
    "scheme": "krimpartner",
    "version": "0.1.0",
    "orientation": "default",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "icon": "./assets/icon.png",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.krimlogistics.partner",
      "icon": "./assets/icon.png"
    },
    "android": {
      "package": "com.krimlogistics.partner",
      "edgeToEdgeEnabled": true,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#071B35"
      },
      "versionCode": 2
    },
    "plugins": [
      "expo-secure-store"
    ],
    "extra": {
      "eas": {
        "projectId": "b747dd8c-2ebc-4f4e-b76e-8d24ec81f3e7"
      }
    },
    "splash": {
      "image": "./assets/krim-master-logo.png",
      "resizeMode": "contain",
      "backgroundColor": "#FFFFFF"
    }
  }
}
