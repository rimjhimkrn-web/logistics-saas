{
  "expo": {
    "name": "KRIM Driver",
    "slug": "krim-driver",
    "owner": "krimlogistics",
    "scheme": "krimdriver",
    "version": "0.1.0",
    "orientation": "default",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "icon": "./assets/adaptive-icon.png",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.krimlogistics.driver",
      "icon": "./assets/adaptive-icon.png"
    },
    "android": {
      "package": "com.krimlogistics.driver",
      "edgeToEdgeEnabled": true,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#071B35"
      },
      "versionCode": 2
    },
    "plugins": [
      "expo-secure-store",
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow KRIM Driver to select delivery evidence photos from your library."
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "b7c30b66-5d6c-45f7-b311-99ff6e37eb01"
      }
    },
    "splash": {
      "image": "./assets/krim-master-logo.png",
      "resizeMode": "contain",
      "backgroundColor": "#FFFFFF"
    }
  }
}
