{
  "expo": {
    "name": "KRIM Driver",
    "slug": "krim-driver",
    "owner": "krimlogistics",
    "scheme": "krimdriver",
    "version": "0.2.0",
    "orientation": "default",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "icon": "./assets/icon.png",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.krimlogistics.driver",
      "icon": "./assets/icon.png"
    },
    "android": {
      "package": "com.krimlogistics.driver",
      "edgeToEdgeEnabled": true,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#071B35"
      },
      "versionCode": 3,
      "permissions": [
        "android.permission.POST_NOTIFICATIONS"
      ]
    },
    "plugins": [
      "expo-secure-store",
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow KRIM Driver to select delivery evidence photos from your library."
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Allow KRIM Driver to share your location while you are using the app for an assigned shipment.",
          "locationAlwaysAndWhenInUsePermission": "Allow KRIM Driver to share your location only during an active assigned shipment trip, including while the app is in the background, after you explicitly start trip tracking.",
          "isAndroidBackgroundLocationEnabled": true,
          "isAndroidForegroundServiceEnabled": true,
          "isIosBackgroundLocationEnabled": true
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "b7c30b66-5d6c-45f7-b311-99ff6e37eb01"
      }
    },
    "splash": {
      "image": "./assets/krim-master-logo.png",
      "resizeMode": "contain",
      "backgroundColor": "#FFFFFF"
    }
  }
}
