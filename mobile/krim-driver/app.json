{
  "expo": {
    "name": "KRIM Driver",
    "slug": "krim-driver",
    "scheme": "krimdriver",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.krimlogistics.driver"
    },
    "android": {
      "package": "com.krimlogistics.driver",
      "edgeToEdgeEnabled": true
    },
    "plugins": [
      "expo-secure-store"
    ]
  }
}
