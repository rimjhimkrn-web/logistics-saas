{
  "expo": {
    "name": "KRIM Driver",
    "slug": "krim-driver",
    "owner": "krimlogistics",
    "scheme": "krimdriver",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "icon": "./assets/icon.png",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.krimlogistics.driver",
      "icon": "./assets/icon.png"
    },
    "android": {
      "package": "com.krimlogistics.driver",
      "edgeToEdgeEnabled": true,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#B45309"
      },
      "versionCode": 2
    },
    "plugins": [
      "expo-secure-store"
    ],
    "extra": {
      "eas": {
        "projectId": "b7c30b66-5d6c-45f7-b311-99ff6e37eb01"
      }
    }
  }
}
