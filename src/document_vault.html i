<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Document Vault & Compliance — KRIM LOGISTICS OS</title>
  
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800;900&family=JetBrains+Mono:wght@400;600;700&display=swap" rel="stylesheet">

  <style>
    :root {
      --krim-bg: #030712;
      --krim-surface: #0b1329;
      --krim-surface-card: #0f172a;
      --krim-border: rgba(255, 255, 255, 0.08);
      --krim-cyan: #00d2ff;
      --krim-emerald: #10b981;
      --krim-amber: #f59e0b;
      --krim-purple: #c084fc;
      --krim-rose: #f43f5e;
      --krim-text-muted: #94a3b8;
      --font-code: "JetBrains Mono", monospace;
      --font-sans: "Inter", -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
    }

    * { margin: 0; padding: 0; box-sizing: border-box; }
    body {
      background: var(--krim-bg);
      color: #fff;
      font-family: var(--font-sans);
      -webkit-font-smoothing: antialiased;
      display: flex;
      min-height: 100vh;
      overflow: hidden;
    }

    /* SIDEBAR NAVIGATION */
    aside {
      width: 260px;
      background: var(--krim-surface);
      border-right: 1px solid var(--krim-border);
      padding: 24px 16px;
      display: flex;
      flex-direction: column;
      justify-content: space-between;
      flex-shrink: 0;
    }
    .brand-group {
      display: flex;
      align-items: center;
      gap: 12px;
      text-decoration: none;
      color: #fff;
      margin-bottom: 32px;
      padding: 0 12px;
    }
    .logo-icon {
      width: 32px;
      height: 32px;
      background: linear-gradient(135deg, #00d2ff 0%, #0072ff 100%);
      clip-path: polygon(0% 0%, 45% 0%, 100% 50%, 45% 100%, 0% 100%, 45% 50%);
    }
    .brand-text {
      font-weight: 800;
      font-size: 1.1rem;
      letter-spacing: -0.01em;
      line-height: 1;
    }
    .brand-text span {
      display: block;
      font-size: 0.6rem;
      letter-spacing: 0.22em;
      color: var(--krim-text-muted);
      font-weight: 600;
      margin-top: 2px;
    }

    .nav-menu {
      list-style: none;
      display: flex;
      flex-direction: column;
      gap: 8px;
    }
    .nav-item a {
      display: flex;
      align-items: center;
      gap: 12px;
      padding: 12px 16px;
      color: var(--krim-text-muted);
      text-decoration: none;
      font-size: 0.88rem;
      border-radius: 10px;
      transition: background 0.2s, color 0.2s;
    }
    .nav-item a:hover, .nav-item a.active {
      background: rgba(0, 210, 255, 0.1);
      color: #fff;
      font-weight: 600;
    }
    .nav-item a.active {
      border: 1px solid rgba(0, 210, 255, 0.25);
    }

    /* MAIN VIEW */
    main {
      flex-grow: 1;
      padding: 32px 48px;
      overflow-y: auto;
    }
    .header-bar {
      display: flex;
      justify-content: space-between;
      align-items: center;
      margin-bottom: 28px;
    }

    /* CONTROLS & FILTER BAR */
    .filter-bar {
      display: flex;
      gap: 16px;
      margin-bottom: 24px;
      background: var(--krim-surface-card);
      border: 1px solid var(--krim-border);
      padding: 12px 20px;
      border-radius: 14px;
      align-items: center;
    }
    .search-input {
      background: rgba(255, 255, 255, 0.04);
      border: 1px solid var(--krim-border);
      color: #fff;
      padding: 10px 16px;
      border-radius: 8px;
      font-size: 0.88rem;
      outline: none;
      flex-grow: 1;
      font-family: inherit;
    }
    .search-input:focus {
      border-color: var(--krim-cyan);
    }
    .filter-select {
      background: rgba(255, 255, 255, 0.04);
      border: 1px solid var(--krim-border);
      color: #fff;
      padding: 10px 16px;
      border-radius: 8px;
      font-size: 0.88rem;
      outline: none;
      font-family: inherit;
      cursor: pointer;
    }

    /* LAYOUT CARDS & TABLES */
    .dashboard-card {
      background: var(--krim-surface-card);
      border: 1px solid var(--krim-border);
      border-radius: 20px;
      padding: 24px;
      margin-bottom: 28px;
    }
    .data-table {
      width: 100%;
      border-collapse: collapse;
      font-size: 0.88rem;
    }
    .data-table th, .data-table td {
      padding: 14px 16px;
      text-align: left;
      border-bottom: 1px solid var(--krim-border);
    }
    .data-table th {
      color: var(--krim-text-muted);
      font-family: var(--font-code);
      font-size: 0.75rem;
    }

    /* BADGES & BUTTONS */
    .status-tag {
      display: inline-block;
      padding: 4px 10px;
      border-radius: 6px;
      font-size: 0.72rem;
      font-family: var(--font-code);
      font-weight: 600;
    }
    .btn-action {
      background: linear-gradient(135deg, #00d2ff 0%, #0072ff 100%);
      color: #fff;
      font-weight: 700;
      border: none;
      padding: 10px 18px;
      border-radius: 8px;
      cursor: pointer;
      font-size: 0.82rem;
    }
    .btn-link {
      color: var(--krim-cyan);
      text-decoration: none;
      font-family: var(--font-code);
      font-size: 0.8rem;
      font-weight: 700;
    }
  </style>
</head>
<body>

  <!-- NAVIGATION SIDEBAR -->
  <aside>
    <div>
      <a href="/index.html" class="brand-group">
        <div class="logo-icon"></div>
        <div class="brand-text">
          KRIM
          <span>LOGISTICS OS</span>
        </div>
      </a>

      <ul class="nav-menu">
        <li class="nav-item"><a href="/dashboard.html">📊 Workspace Summary</a></li>
        <li class="nav-item"><a href="/src/shipments/list.html">📦 Active Shipments</a></li>
        <li class="nav-item"><a href="/src/financial_hub.html">💳 Financial Hub</a></li>
        <li class="nav-item"><a href="/src/telemetry_center.html">📡 Live Telemetry Map</a></li>
        <li class="nav-item"><a href="/src/document_vault.html" class="active">📁 Document Vault</a></li>
      </ul>
    </div>

    <div style="padding: 12px; border-top: 1px solid var(--krim-border);">
      <a href="/dashboard.html" style="color: var(--krim-text-muted); text-decoration: none; font-size: 0.8rem; font-family: var(--font-code);">← Back to Workspace</a>
    </div>
  </aside>

  <!-- MAIN VAULT VIEW -->
  <main>
    <div class="header-bar">
      <div>
        <h1 style="font-size: 1.8rem; font-weight: 800;">Compliance & Document Vault</h1>
        <p style="color: var(--krim-text-muted); font-size: 0.88rem; margin-top: 4px;">Cryptographically verified customs declarations, e-PODs, and waybills.</p>
      </div>

      <button class="btn-action" onclick="uploadDocument()">+ Upload Compliance Doc</button>
    </div>

    <!-- FILTER BAR -->
    <div class="filter-bar">
      <input type="text" id="doc-search" class="search-input" placeholder="Search Document Name, Manifest REF, or HS Code..." onkeyup="filterDocs()" />
      
      <select id="doc-type" class="filter-select" onchange="filterDocs()">
        <option value="ALL">All Document Types</option>
        <option value="BOL">Bill of Lading (BOL)</option>
        <option value="CUSTOMS">Customs Clearance</option>
        <option value="POD">Proof of Delivery (e-POD)</option>
        <option value="KYB">Carrier Verification</option>
      </select>
    </div>

    <!-- DOCUMENT VAULT TABLE -->
    <div class="dashboard-card">
      <table class="data-table" id="vault-table">
        <thead>
          <tr>
            <th>DOCUMENT NAME</th>
            <th>CATEGORY</th>
            <th>ASSOCIATED MANIFEST</th>
            <th>VERIFICATION STATE</th>
            <th>TIMESTAMP</th>
            <th>ACTION</th>
          </tr>
        </thead>
        <tbody>
          <tr>
            <td style="font-weight: 700;">📄 Ocean_Bill_of_Lading_KRM8820.pdf</td>
            <td><span style="font-family: var(--font-code); font-size: 0.78rem;">BOL</span></td>
            <td style="font-family: var(--font-code); color: var(--krim-cyan);">KRM-8820-EU</td>
            <td><span class="status-tag" style="background: rgba(16, 185, 129, 0.1); color: var(--krim-emerald);">VERIFIED ON-CHAIN</span></td>
            <td style="font-family: var(--font-code); color: var(--krim-text-muted);">Oct 04, 2026</td>
            <td><a href="#" class="btn-link" onclick="previewDoc('BOL_8820')">Preview & Download</a></td>
          </tr>
          <tr>
            <td style="font-weight: 700;">📋 Customs_Declaration_HS8504.pdf</td>
            <td><span style="font-family: var(--font-code); font-size: 0.78rem;">CUSTOMS</span></td>
            <td style="font-family: var(--font-code); color: var(--krim-cyan);">KRM-9041-IN</td>
            <td><span class="status-tag" style="background: rgba(0, 210, 255, 0.1); color: var(--krim-cyan);">PENDING STAMP</span></td>
            <td style="font-family: var(--font-code); color: var(--krim-text-muted);">Oct 05, 2026</td>
            <td><a href="#" class="btn-link" onclick="previewDoc('CUSTOMS_9041')">Preview & Download</a></td>
          </tr>
          <tr>
            <td style="font-weight: 700;">⚠️ Exception_Report_CustomsHold.pdf</td>
            <td><span style="font-family: var(--font-code); font-size: 0.78rem;">CUSTOMS</span></td>
            <td style="font-family: var(--font-code); color: var(--krim-rose);">EX-9041-NL</td>
            <td><span class="status-tag" style="background: rgba(244, 63, 94, 0.1); color: var(--krim-rose);">REQUIRES RE-UPLOAD</span></td>
            <td style="font-family: var(--font-code); color: var(--krim-text-muted);">Oct 03, 2026</td>
            <td><a href="#" class="btn-link" style="color: var(--krim-rose);" onclick="uploadDocument('EX-9041-NL')">Replace File</a></td>
          </tr>
          <tr>
            <td style="font-weight: 700;">✍️ Digital_ePOD_Signed_KRM3301.pdf</td>
            <td><span style="font-family: var(--font-code); font-size: 0.78rem;">POD</span></td>
            <td style="font-family: var(--font-code); color: var(--krim-text-muted);">KRM-3301-AE</td>
            <td><span class="status-tag" style="background: rgba(16, 185, 129, 0.1); color: var(--krim-emerald);">VERIFIED ON-CHAIN</span></td>
            <td style="font-family: var(--font-code); color: var(--krim-text-muted);">Oct 02, 2026</td>
            <td><a href="#" class="btn-link" onclick="previewDoc('POD_3301')">Preview & Download</a></td>
          </tr>
        </tbody>
      </table>
    </div>
  </main>

  <script>
    function filterDocs() {
      const searchVal = document.getElementById('doc-search').value.toLowerCase();
      const typeVal = document.getElementById('doc-type').value;
      const rows = document.querySelectorAll('#vault-table tbody tr');

      rows.forEach(row => {
        const text = row.textContent.toLowerCase();
        const typeMatch = typeVal === 'ALL' || row.cells[1].textContent.includes(typeVal);
        const searchMatch = text.includes(searchVal);

        if (typeMatch && searchMatch) {
          row.style.display = '';
        } else {
          row.style.display = 'none';
        }
      });
    }

    function uploadDocument(manifest = '') {
      const target = manifest ? ` for Manifest ${manifest}` : '';
      alert(`Opening secure file dropzone${target}. Document hash will be anchored to KRIM Ledger.`);
    }

    function previewDoc(id) {
      alert(`Decrypting and fetching document preview [${id}]...`);
    }
  </script>

</body>
</html>
